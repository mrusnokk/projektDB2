@model IEnumerable<projektDB2.Models.InventoryItem>
@{
    ViewData["Title"] = "Inventář Hráče";
    var currentUser = ViewBag.CurrentUser as projektDB2.Models.User;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-4">
    
    <div class="alert alert-info d-flex justify-content-between">
        @if (currentUser != null)
        {
            <h4>Jméno uživatele: <strong>@currentUser.Username</strong> (ID: @currentUser.Id)</h4>
            <h4>Zůstatek (Balance): <strong>@currentUser.Balance</strong></h4>
        }
        else
        {
            <h4>Uživatel nenalezen</h4>
        }
    </div>

    <div class="row">
        <div class="col-md-4">
            
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">VYHLEDAT SKIN & PŘIDAT ITEM</div>
                <div class="card-body">
                    <form asp-action="AddSkin" method="post">
                        <input type="hidden" name="userId" value="@(currentUser?.Id ?? 1)" />
                        
                        <div class="mb-3">
                            <label>Skin ID (z vyhledávání):</label>
                            <input type="number" name="skinId" class="form-control" required />
                            <small class="text-muted">Zadej ID skinu z databáze</small>
                        </div>
                        <div class="mb-3">
                            <label>Float value :</label>
                            <input type="number" step="0.000001" name="floatValue" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label>Pattern seed :</label>
                            <input type="number" name="patternSeed" class="form-control" min="0" max="1000" required />
                        </div>
                        <div class="form-check mb-3">
                            <input type="checkbox" name="isStatTrak" value="true" class="form-check-input" id="stCheck" />
                            <label class="form-check-label" for="stCheck">StatTrak </label>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Přidat item</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-dark text-white">INVENTÁŘ HRÁČE</div>
                <div class="card-body p-0">
                    <table class="table table-striped table-hover m-0">
                        <thead class="table-dark">
                            <tr>
                                <th>item_id </th>
                                <th>skin name </th>
                                <th>float </th>
                                <th>seed </th>
                                <th>rarity </th>
                                <th>stattrak </th>
                                <th>akce </th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>#@item.Id</td>
                                        <td>
                                            @item.WeaponName | @item.SkinName
                                            <br />
                                            <small class="text-muted">Stickers: @item.StickerCount</small>
                                        </td>
                                        <td>@item.FloatValue.ToString("0.00000")</td>
                                        <td>@item.PatternSeed</td>
                                        <td>
                                            <span style="color: @item.ColorHex; font-weight: bold;">@item.Rarity</span>
                                        </td>
                                        <td>@(item.IsStatTrak ? "ST" : "-")</td>
                                        <td>
                                            <form asp-action="DeleteItem" method="post" class="d-inline">
                                                <input type="hidden" name="itemId" value="@item.Id" />
                                                <input type="hidden" name="currentUserId" value="@(currentUser?.Id ?? 1)" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Odstranit</button>
                                            </form>

                                            <a asp-action="Sticker" asp-route-itemId="@item.Id" asp-route-userId="@(currentUser?.Id ?? 1)" class="btn btn-sm btn-outline-warning">Sticker</a>
    
                                            <a asp-action="Trade" asp-route-itemId="@item.Id" asp-route-userId="@(currentUser?.Id ?? 1)" class="btn btn-sm btn-outline-primary">Trade</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center">Inventář je prázdný.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>